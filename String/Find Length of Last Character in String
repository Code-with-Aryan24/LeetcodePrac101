class Solution {
    public int lengthOfLastWord(String s) 
    {
        int length = 0;
        
        // Start from the last character of the string
        for (int i = s.length() - 1; i >= 0; i--) 
        {
            
            if (s.charAt(i) != ' ') 
            {
                length++;
            } 
            
            else if (length > 0)
            {
                break;
            }
        }
        
        return length;
    }
}
